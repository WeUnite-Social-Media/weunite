# WeUnite local environment
#
# Copy this file to `.env` in the repository root.
# App-level `.env` files can still be used as local overrides when running an app outside Docker.

# Host ports published by Docker Compose.
WEB_HOST_PORT=3000
API_HOST_PORT=8080
DB_HOST_PORT=5432
API_ONLY_HOST_PORT=8081
API_DB_HOST_PORT=5433

# Ports used by the API and database inside their runtime.
SERVER_PORT=8080
DB_PORT=5432

# Active database used when the API runs locally through Maven.
# Set DB_PASSWORD to the password of the database that the local API should use:
# - DB_DOCKER_PASSWORD when PostgreSQL runs in Docker.
# - DB_LOCAL_PASSWORD when PostgreSQL runs natively on the host.
DB_HOST=localhost
DB_NAME=weunite
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Native PostgreSQL credentials used by Dockerized API when it connects to
# PostgreSQL running directly on the host machine.
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=5432
DB_LOCAL_NAME=weunite
DB_LOCAL_USERNAME=postgres
DB_LOCAL_PASSWORD=your-native-postgres-password

# Docker-managed PostgreSQL credentials. These are used by Compose when it
# creates the `db` container and by Dockerized API services connected to it.
DB_DOCKER_NAME=weunite
DB_DOCKER_USERNAME=postgres
DB_DOCKER_PASSWORD=postgres

# When the API runs in Docker and PostgreSQL runs natively on the host,
# Docker should reach the host through this name.
LOCAL_DB_HOST_FOR_DOCKER=host.docker.internal

# Browser-facing web configuration.
VITE_API_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws
VITE_MEDIA_URL=http://localhost:8080

# API CORS origins for local web ports.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base64 of the full RSA PEM, including BEGIN/END lines.
JWT_PUBLIC_KEY=base64_of_full_rsa_public_pem
JWT_PRIVATE_KEY=base64_of_full_rsa_private_pem

# Values must exist for the API to boot. Local placeholders are fine
# until email flows are tested.
MAIL_USERNAME=local@example.com
MAIL_PASSWORD=local-password
MAIL_PORT=587

# Valid placeholder format; replace with real data when testing uploads.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
