<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from Android 8 on. The launcher masks the two layers to
  whatever shape the phone uses (circle on MIUI, squircle on Pixel), so the
  wordmark in the foreground sits inside the 66/108 dp safe zone and the
  background carries the brand dark.

  The square PNGs in mipmap-*dpi/ic_launcher.png stay as the fallback for
  older Androids.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
